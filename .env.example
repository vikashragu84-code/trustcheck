# AI Provider Failover Order (Optional, defaults to gemini,groq)
# Order of providers to try sequentially before falling back to local engine
AI_PROVIDER_ORDER=gemini,groq

# Google Gemini API key (Required for Gemini AI provider)
GEMINI_API_KEY=

# Groq API key (Required for Groq AI provider)
GROQ_API_KEY=

# Port to run the server on (Optional, defaults to 5173)
PORT=5173

# Supabase Configuration (Required for Auth & History)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

